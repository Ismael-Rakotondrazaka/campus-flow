    "@nuxt/hints": "^1.0.2",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/leaflet": "^1.3.2",
    "@nuxtjs/seo": "^5.0.2",
    "@nuxtjs/supabase": "^2.0.4",
    "@pinia/colada": "^1.1.0",
    "@pinia/colada-nuxt": "^0.3.2",
    "@pinia/nuxt": "^0.11.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/vue-table": "^8.21.3",
