    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.41",
    "lucide-vue-next": "^1.0.0",
    "mustache": "^4.2.0",
    "nuxt": "^4.4.2",
    "reka-ui": "^2.9.3",
    "satori": "^0.26.0",
    "shadcn-nuxt": "^2.4.3",
